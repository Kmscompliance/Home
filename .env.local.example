# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Anthropic API key, used by the quote engine and assistant to call Claude.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for classification/explanation
# calls (src/lib/anthropic/client.ts). Defaults to claude-sonnet-5.
# CLAUDE_MODEL=claude-sonnet-5
