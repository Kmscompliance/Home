# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Anthropic API key, used by the quote engine and assistant to call Claude.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for classification/explanation
# calls (src/lib/anthropic/client.ts). Defaults to claude-sonnet-5.
# CLAUDE_MODEL=claude-sonnet-5

# Required to access /admin — a shared password (HTTP Basic Auth), not a
# real per-admin login. Any username works; only the password is checked.
# Leaving this unset disables /admin entirely rather than leaving it open.
ADMIN_PASSWORD=

# Which quote provider actually prices a submitted quote
# (src/lib/quoteProvider/). Defaults to "local" — BeesKnee's own pricing
# engine. Set to "mock-acturis" to route quotes through the fictional demo
# insurer instead (src/lib/mockInsurer/underwriting.ts), which has its own
# rates and can also refer/decline a risk, not just price it. Restart
# `next dev` after changing this.
# QUOTE_PROVIDER=local
