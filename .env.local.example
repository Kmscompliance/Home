# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Anthropic API key, used by the quote engine and assistant to call Claude.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for classification/explanation
# calls (src/lib/anthropic/client.ts). Defaults to claude-sonnet-5.
# CLAUDE_MODEL=claude-sonnet-5

# Required to access /admin — a shared password (HTTP Basic Auth), not a
# real per-admin login. Any username works; only the password is checked.
# Leaving this unset disables /admin entirely rather than leaving it open.
ADMIN_PASSWORD=

# Which quote provider actually prices a submitted quote
# (src/lib/quoteProvider/). Defaults to "local" — BeesKnee's own pricing
# engine. Set to "mock-acturis" to route quotes through the fictional demo
# insurer instead (src/lib/mockInsurer/underwriting.ts), which has its own
# rates and can also refer/decline a risk, not just price it. Restart
# `next dev` after changing this.
# QUOTE_PROVIDER=local

# Required for /admin to work — a random secret used to sign admin login
# sessions (src/lib/adminAuth.ts). Separate from ADMIN_PASSWORD on
# purpose. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leaving this unset disables admin login entirely.
AUTH_SECRET=

# Cost control for every route that calls Claude (src/lib/claudeGuard.ts):
# max requests per client IP, per window, before a 429 is returned.
# Defaults shown below are generous for a demo — tighten once you have a
# sense of real traffic. See the "API usage" card on /admin for what's
# actually being called.
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MS=60000
